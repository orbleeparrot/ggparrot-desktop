{
  "name": "ggparrot-desktop",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install webkit chromium",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "oxlint .",
    "tauri": "tauri",
    "format": "oxfmt . && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:check": "oxfmt --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings",
    "check:versions": "node scripts/check-versions.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "build:mac": "tauri build --target universal-apple-darwin && node scripts/name-bundles.mjs",
    "build:win": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 CARGO_TARGET_DIR=\"$PWD/src-tauri/target-win\" CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER=x86_64-w64-mingw32-gcc tauri build --target x86_64-pc-windows-gnu --bundles nsis && node scripts/name-bundles.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "lightweight-charts": "5.2.1",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
