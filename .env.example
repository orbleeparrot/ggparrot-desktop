# 개발·시험용 환경 변수. 앱은 .env 파일을 읽지 않음 — 셸에서 export하거나 실행 명령 앞에 붙임.
#   set -a; source .env; set +a; npm run tauri dev
# 배포 빌드는 아무것도 설정하지 않아도 됨.

# 서버 주소. 비우면 배포 서버를 씀. (실행 시 값 → 빌드 시 값 → 기본값 순)
GGP_SERVER_BASE=

# 회원 키를 미리 채움(시험용). 비우면 앱에서 입력하거나 웹의 [실행기 열기]로 받음.
GGP_MEMBER_KEY=

# 매크로 폴더. 비우면 앱 데이터 폴더의 macros(macOS ~/Library/Application Support/ggparrot-desktop/macros)
GGP_MACRO_DIR=

# 1이면 키를 OS 키체인 대신 메모리에만 둠(개발 빌드만, 시연·스크린샷용). 앱을 끄면 사라짐.
GGP_MEMORY_KEYS=

# 1회 주문 상한. 기본 USDT 100·KRW 150000
MAX_ORDER_USDT=
MAX_ORDER_KRW=

# 선물 상한 기준: notional(기본) | margin
ORDER_CAP_BASIS=
