{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GGParrot",
  "mainBinaryName": "ggparrot-desktop",
  "identifier": "com.ggparrot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "껄무새",
        "width": 1040,
        "height": 720,
        "minWidth": 720,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "appDirectoriesOverride": "$LOCALDATA/ggparrot-desktop"
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Finance",
    "shortDescription": "GGParrot (껄무새)",
    "longDescription": "껄무새 웹에서 만든 매크로를 이 PC에서 실행합니다. 거래소 API 키는 이 기기에만 보관됩니다.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "template": "installer/installer.nsi",
        "installerHooks": "installer/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "installer/dmg-background.tiff",
        "windowSize": {
          "width": 540,
          "height": 380
        },
        "appPosition": {
          "x": 140,
          "y": 165
        },
        "applicationFolderPosition": {
          "x": 400,
          "y": 165
        }
      },
      "files": {
        "Resources/ko.lproj/InfoPlist.strings": "macos/ko.lproj/InfoPlist.strings",
        "Resources/en.lproj/InfoPlist.strings": "macos/en.lproj/InfoPlist.strings"
      }
    },
    "publisher": "껄무새",
    "copyright": "© 껄무새"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "ggparrot"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0RTE4QjVFMTEwQTRBNjkKUldScFNnb1JYb3ZoQk4zWTliUXBWT3JCbHpqdzY1QWcwNzFsNXVCZXZ1QVpTc0FKUlc3MlpsOXkK",
      "endpoints": [
        "https://github.com/orbleeparrot/ggparrot-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
